{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PTT: Build Firmware",
            "type": "process",
            "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
            "args": ["run", "--environment", "xiao_esp32s3"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "PTT: Upload Firmware",
            "type": "process",
            "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
            "args": ["run", "--environment", "xiao_esp32s3", "--target", "upload"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "PTT: Test Debounce",
            "type": "process",
            "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
            "args": ["test", "--environment", "native"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:USERPROFILE}\\.platformio\\packages\\toolchain-gccmingw32\\bin;${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": ["$gcc"]
        }
    ]
}